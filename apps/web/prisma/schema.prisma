// مخطط قاعدة البيانات لمنصة مزاد
// راجع docs/06-data-model.md للشرح المفاهيمي

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── المستخدمون ─────────────────────────

enum Role {
  USER
  BROKER
  ADMIN
}

enum IdentityStatus {
  NONE
  PENDING
  VERIFIED
}

model User {
  id              String         @id @default(uuid())
  phone           String         @unique
  name            String
  role            Role           @default(USER)
  accountType     String?        @default("SHOPPER") // الدور التفصيلي
  isPhoneVerified Boolean        @default(false)
  identityStatus  IdentityStatus @default(NONE)
  city            String?
  region          String?
  trustScore      Float          @default(0)
  interests       String[]       @default([]) // معرّفات التصنيفات التي يهتم بها (أي مستوى)
  brokerCategories String[]      @default([]) // نطاق الدلال: التصنيفات المُسندة إليه
  brokerSharePct  Float?         // نسبة الدلال من العمولة (تجاوز للنسبة العامة)
  active          Boolean        @default(true) // تفعيل/تعطيل الحساب (للدلالين خاصة)
  createdAt       DateTime       @default(now())

  listings        Listing[]
  bids            Bid[]
  brokeredAuctions Auction[]     @relation("BrokerAuctions")
  reviewsAuthored Review[]       @relation("ReviewAuthor")
  reviewsReceived Review[]       @relation("ReviewTarget")
  messages        Message[]
  reports         Report[]
  otps            OtpCode[]
  favorites       Favorite[]
  walletTxns      WalletTxn[]
  disputes        Dispute[]      @relation("DisputeOpener")
  notifications   Notification[]
}

// رموز التحقق بالجوال
model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([phone])
}

// ───────────────────────── التصنيف الهرمي ─────────────────────────

enum CategoryLevel {
  SPECIES // نوع البهيمة (إبل، غنم...)
  TYPE    // صنف/لون
  BREED   // سلالة
}

model Category {
  id       String        @id @default(uuid())
  name      String
  level     CategoryLevel
  icon      String?
  themeKey  String?
  motifKey  String?
  shapeKey  String?
  layoutKey String?
  cardStyle String?
  hidden    Boolean       @default(false)
  order     Int           @default(0)
  parentId  String?
  parent   Category?     @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]    @relation("CategoryTree")
  listings Listing[]

  @@index([parentId])
}

// ───────────────────────── الإعلانات ─────────────────────────

enum Sex {
  MALE
  FEMALE
  MIXED
}

enum SaleType {
  DIRECT
  AUCTION
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  CLOSED
}

model Listing {
  id               String        @id @default(uuid())
  seller           User          @relation(fields: [sellerId], references: [id])
  sellerId         String
  category         Category      @relation(fields: [categoryId], references: [id])
  categoryId       String
  title            String
  description      String
  count            Int           @default(1)
  sex              Sex           @default(MIXED)
  approxWeightKg   Int?
  productionStatus String?
  price            Decimal?      @db.Decimal(12, 2)
  saleType         SaleType      @default(DIRECT)
  city             String
  region           String
  lat              Float?
  lng              Float?
  hidePhone        Boolean       @default(false)
  status           ListingStatus @default(ACTIVE)
  archived         Boolean       @default(false) // أرشفة من البائع
  views            Int           @default(0)
  createdAt        DateTime      @default(now())

  media   Media[]
  health  HealthAttribute[]
  auction Auction?
  conversations Conversation[]
  favorites Favorite[]
  disputes Dispute[]

  @@index([categoryId, status, region])
  @@index([status, createdAt])
}

// الحالة الصحية والعيوب (إفصاح إلزامي)
model HealthAttribute {
  id        String  @id @default(uuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  key       String  // vaccinated / udder / abscess / mange / teeth / limp ...
  label     String? // نص البند وقت الإدخال (سليم/غير سليم)
  value     Boolean // true = سليم، false = غير سليم
  note      String?

  @@index([listingId])
}

// بنود الحالة الصحية (تُدار من الإدارة: إضافة/تعديل/حذف)
model HealthItem {
  id        String   @id @default(uuid())
  label     String
  order     Int      @default(0)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([hidden, order])
}

enum MediaType {
  IMAGE
  VIDEO
  VIDEO_360
  AUDIO
  DOC
}

model Media {
  id        String    @id @default(uuid())
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  type      MediaType @default(IMAGE)
  url       String
  order     Int       @default(0)

  @@index([listingId])
}

// ───────────────────────── المزادات ─────────────────────────

enum AuctionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model Auction {
  id            String        @id @default(uuid())
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId     String        @unique
  broker        User?         @relation("BrokerAuctions", fields: [brokerId], references: [id])
  brokerId      String?
  startPrice    Decimal       @db.Decimal(12, 2)
  minIncrement  Decimal       @default(100) @db.Decimal(12, 2)
  reservePrice  Decimal?      @db.Decimal(12, 2)
  deposit       Decimal?      @db.Decimal(12, 2)
  startAt       DateTime
  endAt         DateTime
  antiSnipingSec Int          @default(60)
  status        AuctionStatus @default(SCHEDULED)
  highestBidId  String?
  typeId        String?
  type          AuctionType?  @relation(fields: [typeId], references: [id])
  createdAt     DateTime      @default(now())

  bids Bid[]

  @@index([status, endAt])
}

model Bid {
  id        String   @id @default(uuid())
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId String
  bidder    User     @relation(fields: [bidderId], references: [id])
  bidderId  String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([auctionId, amount])
}

// ───────────────────────── الثقة والتقييم ─────────────────────────

enum ReviewRole {
  BUYER
  SELLER
  BROKER
}

model Review {
  id        String     @id @default(uuid())
  author    User       @relation("ReviewAuthor", fields: [authorId], references: [id])
  authorId  String
  target    User       @relation("ReviewTarget", fields: [targetId], references: [id])
  targetId  String
  role      ReviewRole
  rating    Int        // 1..5
  descMatch Int?       // نسبة مطابقة الوصف للواقع 1..5
  comment   String?
  createdAt DateTime   @default(now())

  @@index([targetId])
}

// ───────────────────────── المحادثات ─────────────────────────

model Conversation {
  id        String    @id @default(uuid())
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  buyerId   String?   // طرف المحادثة الخاصة (المشتري)؛ الطرف الآخر هو بائع الإعلان
  isPublic  Boolean   @default(false)
  createdAt DateTime  @default(now())
  messages  Message[]

  @@index([listingId])
  @@index([buyerId])
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  LOCATION
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id])
  senderId       String
  type           MessageType  @default(TEXT)
  body           String
  mediaUrl       String?
  transcript     String?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ───────────────────────── البلاغات (Trust & Safety) ─────────────────────────

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

model Report {
  id         String       @id @default(uuid())
  reporter   User         @relation(fields: [reporterId], references: [id])
  reporterId String
  targetType String       // listing / user / message / auction
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
}

// ───────────────────────── أنواع المزادات (تُدار من الإدارة) ─────────────────────────

model AuctionType {
  id              String    @id @default(uuid())
  name            String
  icon            String?
  description     String?
  commissionPct   Float     @default(0)
  requiresDeposit Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  auctions        Auction[]
}

// ───────────────────────── الإعلانات والمساحات الإعلانية ─────────────────────────

model Ad {
  id          String    @id @default(uuid())
  type        String    @default("BANNER")   // BANNER / CLASSIFIED / HOUSE
  title       String
  imageUrl    String?
  link        String?
  placement   String    @default("HOME_TOP")
  status      String    @default("ACTIVE")   // ACTIVE / PAUSED / PENDING / EXPIRED
  priority    Int       @default(0)
  advertiser  String?
  ownerId     String?                          // المُعلِن (خدمة ذاتية)
  targetCountries String?                       // أكواد دول مفصولة بفواصل (فارغ = الكل)
  targetRegions   String?                       // مناطق/مدن اختيارية
  targetCategories String?                       // معرّفات تصنيفات مفصولة بفواصل (فارغ = كل الأقسام)
  packageKey  String?                          // مفتاح الباقة
  priceHalalas Int?                             // سعر الباقة (هللات)
  maxImpressions Int?                           // سقف المشاهدات (null = بلا حد)
  startAt     DateTime?
  endAt       DateTime?
  impressions Int       @default(0)
  clicks      Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([placement, status])
  @@index([ownerId])
}

// إحصائيات يومية لكل إعلان (خط زمني)
model AdStat {
  id          String   @id @default(uuid())
  adId        String
  day         String   // YYYY-MM-DD
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@unique([adId, day])
  @@index([adId])
}

// ───────────────────────── مركز النزاعات ─────────────────────────

// نزاع على صفقة بين طرفين، يُحال للإدارة لاتخاذ قرار
model Dispute {
  id         String   @id @default(uuid())
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId  String?
  openedBy   User     @relation("DisputeOpener", fields: [openedById], references: [id])
  openedById String
  againstId  String?  // الطرف الآخر (اختياري)
  reason     String
  detail     String?
  status     String   @default("OPEN") // OPEN / REVIEWING / RESOLVED / REJECTED
  resolution String?  // قرار الإدارة
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([openedById])
}

// ───────────────────────── المحفظة والسجل المالي ─────────────────────────

// حركة مالية في محفظة المستخدم (موجب = إضافة، سالب = خصم)
model WalletTxn {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // TOPUP / COMMISSION / DEPOSIT_HOLD / DEPOSIT_RELEASE / PAYOUT / REFUND
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  refId     String?  // مرجع (إعلان/مزاد) اختياري
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ───────────────────────── الإشعارات ─────────────────────────

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String   // LISTING_APPROVED / OUTBID / VERIFIED / DISPUTE / EARNING / GENERAL
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// ───────────────────────── إعدادات المنصة ─────────────────────────

// إعدادات عامة (مفتاح/قيمة) تُدار من الإدارة — مثل وضع الدخول العام/المتخصص
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// ───────────────────────── المفضلة ─────────────────────────

model Favorite {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}
